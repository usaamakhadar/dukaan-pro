# ==============================================================================
# DUKAAN PRO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate the values below before starting the app.
#
#   cp .env.example .env.local
#
# ==============================================================================

# Supabase Cloud or Self-Hosted Configuration
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Playwright End-to-End (E2E) Stress Testing Credentials
# Required to execute tests in e2e/pos-stress.spec.ts against a seeded test tenant
E2E_TEST_EMAIL=cashier@example.com
E2E_TEST_PASSWORD=your-secure-test-password

# Optional: Secondary Tenant Credentials for Multi-Tenant RLS Leakage Verification Test
E2E_TEST_EMAIL_B=tenant_b_owner@example.com
E2E_TEST_PASSWORD_B=your-tenant-b-password
